{
	"name": "backleaf",
	"version": "1.2.0",
	"description": "Backleaf: discuss PDF selections in Obsidian with your own AI provider (BYOK) and keep structured reading notes.",
	"main": "main.js",
	"private": true,
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"typecheck": "tsc -noEmit -skipLibCheck",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"test": "npm run build && node --test \"tests/*.test.js\"",
		"deploy:clean": "npm run build && node scripts/deploy-clean.mjs"
	},
	"license": "MIT",
	"devDependencies": {
		"@codemirror/state": "6.5.0",
		"@codemirror/view": "6.38.6",
		"@types/node": "22.20.4",
		"esbuild": "0.25.12",
		"obsidian": "1.13.1",
		"typescript": "5.9.3"
	}
}
